# YouTube Data API v3 のAPIキー
#
# 取得手順:
#   1. https://console.cloud.google.com/ でプロジェクトを作成（既存でも可）
#   2. 「APIとサービス」→「ライブラリ」→ "YouTube Data API v3" を検索して【有効にする】
#   3. 「APIとサービス」→「認証情報」→「認証情報を作成」→「APIキー」
#   4. 発行されたキーを下の行に貼る
#
# このファイルを .env にコピーして使う:
#   cp .env.example .env
#
# .env は .gitignore 済みなのでコミットされない。
YOUTUBE_API_KEY=

# 収集条件（未設定ならスクリプト側のデフォルトが使われる）
# WANT=10             # 採用する本数
# MONTHS=6            # 直近何か月を対象にするか
# MIN_VIEWS=10000     # 再生数の下限
# MAX_SUBS=10000      # 登録者数の上限
# MAX_PER_CHANNEL=2   # 同一チャンネルからの採用上限
# PER_QUERY=50        # 1クエリあたりの検索件数（API上限50）
# COMMENTS=20         # 1動画あたり取得する上位コメント数
